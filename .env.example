# Optional settings. Copy to your hosting panel's environment variables.
PORT=3000
# Set this to create the admin password automatically on first start (min 8 chars).
# If you leave it empty, press Ctrl+Alt+D on the site and create the password there.
ADMIN_PASSWORD=
# Set to 1 if your site is served over HTTPS behind a proxy that does not send x-forwarded-proto.
COOKIE_SECURE=
# Where content and uploaded images are stored (default: ./data). Point this to a persistent disk.
DATA_DIR=
